## APP ##
PORT=3000
LOG_LEVEL=debug
LOG_SERVICE_NAME=solana-nft
UPLOADS_DIR=./uploads

## WEB3 SOLANA CHAIN CONFIG FOR NFTS ##
CLUSTER_API_URL=devnet # solana network
WALLET_KEYPAIR="./keys/id.json" # path to the id.json file corresponding to the solana wallet keypair
SELLER_FEE_BASIS_POINTS=
STORAGE_URL=https://devnet.bundlr.network # storage of the nft's metadata
STORAGE_PROVIDER_URL=https://api.devnet.solana.com # the public rpc target of the solana blockchain
STORAGE_CONN_TIMEOUT=60000 # the connection delay for the connection to the storage

## WEB3 AUTH (to manage non custodial wallets securely) ##

# SDK CONFIG
WEB3AUTH_CLIENT_ID=BCi9sz7fdgU5xC8WO00yVh4UJMpreANcrewaYEk6Eprt7z-RYk_R1K7kXSnv7edYkMkq1NBGXB9RCw1LPihQ61Q
WEB3AUTH_NET_ID=sapphire_devnet
WEB3AUTH_VERIFIER=ellitestamp-verifier-1

# CHAIN CONFIG
WEB3AUTH_PROVIDER_CHAIN_ID=0x3 # Please use 0x1 for Mainnet, 0x2 for Testnet, 0x3 for Devnet
WEB3AUTH_PROVIDER_CHAIN_RPC_TARGET=https://api.devnet.solana.com # the public rpc target of the solana blockchain
WEB3AUTH_PROVIDER_CHAIN_DISPLAY_NAME="Solana Devnet"
WEB3AUTH_JWKS_ENDPOINT=https://gist.githubusercontent.com/ysissoko/ef6faaf17daa9c7155ad06ef2e8126b3/raw/e6fbd2fbfa83e122d29216febf420ba843d3bda5/jwks.json

# JWT signature
JWT_PRIVATE_KEY_PATH=./keys/privateKey.pem
JWT_KEYID=3315e0172305e75a5988b56a16c9  #This is a unique identifier for each JWK in the JWK keys set.
JWT_AUDIENCE=urn:api-solana-nft-io #To be set for the web3auth verifier
JWT_ISSUER=https://api.solana-nft.ellitestamp.io  #To be set for the web3auth verifier 

RATE_LIMIT_MSG="You have exceeded your 5 requests per minute limit."
RATE_LIMIT_MAX_PER_WINDOW=100 # X requests max
RATE_LIMIT_WINDOW_MINUTES=15 # every Y minutes
